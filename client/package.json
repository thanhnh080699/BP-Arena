{
    "name":  "bp-arena-client",
    "private":  true,
    "version":  "0.0.1",
    "type":  "module",
    "main":  "main.mjs",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "electron":  "wait-on http://localhost:5173 \u0026\u0026 electron .",
                    "app":  "concurrently \"npm run dev\" \"npm run electron\"",
                    "dist":  "npm run build \u0026\u0026 electron-builder",
                    "dist:win":  "npm run build \u0026\u0026 electron-builder --win"
                },
    "build":  {
                  "appId":  "com.bparena.client",
                  "productName":  "BP-Arena",
                  "directories":  {
                                      "output":  "out-release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "main.mjs",
                                "package.json"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "resources/server",
                                             "to":  "server",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         },
                                         {
                                             "from":  "resources/patches",
                                             "to":  "patches",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         },
                                         {
                                             "from":  "resources/manifests",
                                             "to":  "manifests",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         },
                                         {
                                             "from":  "../game/AOE-HD",
                                             "to":  "game/AOE-HD",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "signAndEditExecutable":  false,
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ]
                          },
                  "nsis":  {
                               "artifactName":  "${productName}-${version}-${arch}-setup.${ext}",
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true
                           },
                  "portable":  {
                                   "artifactName":  "${productName}-${version}-${arch}-portable.${ext}"
                               }
              },
    "dependencies":  {
                         "axios":  "^1.7.7",
                         "framer-motion":  "^11.11.17",
                         "lucide-react":  "^0.460.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.3",
                            "concurrently":  "^9.1.0",
                            "electron":  "^33.2.0",
                            "electron-builder":  "^26.8.1",
                            "vite":  "^5.4.10",
                            "wait-on":  "^8.0.1"
                        }
}
